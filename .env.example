# ZeroGravity Environment Configuration

# Headless Gemini Web Browser Bridge
# Docker bridge (default): http://gemini-bridge:5000
# Native bridge on host (services/browser_bridge/run_local.ps1): http://host.docker.internal:5000
ZEROGRAVITY_BROWSER_URL=http://gemini-bridge:5000
ZEROGRAVITY_HEADLESS=true
# Manual-Submit Mode: set to true on Google Workspace accounts where Gemini requires
# a physical Enter/Send click in the browser window; leave false for personal accounts.
ZEROGRAVITY_MANUAL_SUBMIT=false
GEMINI_RESPONSE_TIMEOUT=240
BROWSER_PROFILE_DIR=/data/browser_profile

# Custom Browser Executable / Channel (e.g. Brave, Chrome, Edge)
# NATIVE BRIDGE ONLY - ignored by the Docker bridge, which ships bundled Chromium.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# Or set Playwright browser channel (chrome, msedge, etc.):
# BROWSER_CHANNEL=chrome
BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=

# ZeroGravity Execution Strategy: 'direct' (patch workspace via MCP) or 'agy' (pass diffs to agy --mode accept-edits)
ZEROGRAVITY_EXECUTION_MODE=direct

# Optional Local AI module (Ollama) - DISABLED by default.
# When false, code blocks from Gemini are cleaned deterministically and written as-is.
# To enable: set to true AND start with `docker compose --profile local-ai up -d`
ZEROGRAVITY_LOCAL_AI=false
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Workspace Mount (host path mounted at /workspace)
WORKSPACE_PATH=./workspace
